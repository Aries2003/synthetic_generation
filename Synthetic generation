        "mask_f = (mask_3ch).astype(np.float32)\n",
        "\n",
        "gp_bg   = build_gaussian_pyramid(bg_f,   LEVELS)# GA\n",
        "gp_fg   = build_gaussian_pyramid(fg_f,   LEVELS)# GB\n",
        "gp_mask = downSize_mask(mask_f, LEVELS)# GM\n",
