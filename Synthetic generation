        "\n",
        "def build_gaussian_pyramid(img, levels):\n",
        "    pyr = [img.copy()]\n",
        "    for _ in range(levels - 1):\n",
        "        img = cv2.pyrDown(img)\n",
        "        pyr.append(img)\n",
        "    return pyr\n",
        "\n",
        "\n",
        "def build_laplacian_pyramid(gp):\n",
        "    lp = []\n",
        "    for i in range(len(gp) - 1):\n",
        "        h, w = gp[i].shape[:2]\n",
        "        expanded = cv2.pyrUp(gp[i + 1], dstsize=(w, h))\n",
        "        lp.append(gp[i] - expanded)\n",
        "    lp.append(gp[-1])\n",
        "    return lp\n",
        "\n",
        "\n",
        "def reconstruct_from_laplacian(lp):\n",
        "    result = lp[-1].copy()\n",
        "    for i in range(len(lp) - 2, -1, -1):\n",
        "        h, w = lp[i].shape[:2]\n",
        "        result = cv2.pyrUp(result, dstsize=(w, h))\n",
        "        result = result + lp[i]\n",
        "    return result\n",
        "\n",
        "\n",
        "def downSize_mask(mask, levels):\n",
        "\n",
        "    pyr = [mask.copy()]\n",
        "    for _ in range(levels - 1):\n",
        "        mask = cv2.resize(\n",
        "            mask,\n",
        "            (int(np.ceil(mask.shape[1] / 2)), int(np.ceil(mask.shape[0] / 2))),\n",
        "            interpolation=cv2.INTER_LINEAR,\n",
        "        )\n",
        "        pyr.append(mask)\n",
        "    return pyr\n",
        "\n"
