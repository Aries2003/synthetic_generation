        "def build_gaussian_pyramid(img, levels):\n",
        "    pyr = [img.copy()]\n",
        "    for _ in range(levels - 1):\n",
        "        img = cv2.pyrDown(img)\n",
        "        pyr.append(img)\n",
        "    return pyr\n",
        "\n",
        "\n",
        "def build_laplacian_pyramid(gp):\n",
        "    lp = []\n",
        "    for i in range(len(gp) - 1):\n",
        "        h, w = gp[i].shape[:2]\n",
        "        expanded = cv2.pyrUp(gp[i + 1], dstsize=(w, h))\n",
        "        # lp = cv2.subtract(gaussian_pyr[i], expanded)\n",
        "        # lp.append(gp[i])\n",
        "        lp.append(gp[i] - expanded)\n",
        "    lp.append(gp[-1])\n",
        "    return lp\n",
        "\n",
        "\n",
        "def reconstruct_from_laplacian(lp):\n",
        "    result = lp[-1].copy()\n",
        "    for i in range(len(lp) - 2, -1, -1):\n",
        "        h, w = lp[i].shape[:2]\n",
        "        result = cv2.pyrUp(result, dstsize=(w, h))\n",
        "        # result = cv2.add(result, lp[i])\n",
        "        result = result + lp[i]\n",
        "    return result\n",
        "\n",
        "def downSize_mask(gp, levels):\n",
        "    pyr = [gp.copy()]\n",
        "    for _ in range(levels - 1):\n",
        "        gp = cv2.resize(gp, (int(np.ceil(gp.shape[1]/2)) , int(np.ceil(gp.shape[0]/2))), interpolation= cv2.INTER_LINEAR)\n",
        "        pyr.append(gp)\n",
        "    return pyr\n",
